# ==============================================================================
# StockTrade Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Flask App Configuration
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
# Generate a production SECRET_KEY via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-unique-64-character-hex-secret-in-production
PORT=5000

# Primary MySQL Database Configuration (App DML User)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stocktrade
DB_USER=stocktrade_app
DB_PASSWORD=replace-with-strong-app-db-password

# Read-Only Database Account for AI SQL Assistant (Least-Privilege)
DB_AI_USER=stocktrade_ai_ro
DB_AI_PASSWORD=replace-with-strong-ai-ro-password

# Database TLS/SSL Configuration (Required for TiDB Cloud, Aiven, AWS RDS)
# Set DB_SSL=true for managed cloud MySQL with verified certificates
DB_SSL=false
# Optional path to CA certificate bundle (e.g., /etc/ssl/certs/ca-certificates.crt on Linux)
DB_SSL_CA=

# Administrative MySQL User for init_db.py / initial migration only (Do NOT expose in production runtime)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=replace-with-root-password

# Separate Test Database Name
TEST_DB_NAME=stocktrade_test

# Trading Engine & Financial Rules
SIGNUP_GRANT_AMOUNT=100000.00
INVESTOR_BROKERAGE_RATE=0.0010
INVESTOR_BROKERAGE_MIN_FEE=1.00
BROKER_COMMISSION_RATE=0.40
PRICE_MOVED_TOLERANCE_PCT=0.01

# Market Simulator
START_SIMULATOR=true
SIMULATOR_TICK_INTERVAL_SEC=0.50
SIMULATOR_DB_FLUSH_SEC=1.0
SIMULATOR_INTERVAL_SECONDS=5
ALWAYS_OPEN=true
MAX_TICK_PCT=0.005
CIRCUIT_LIMIT_PCT=0.10

# Single-Model AI Configuration (Groq / Grok Free Tier API)
LLM_PROVIDER_ORDER=groq,grok
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta
LLM_TIMEOUT_SECONDS=20
LLM_COOLDOWN_SECONDS=60

# Demo User Default Passwords (seeded for academic evaluation)
DEMO_ADMIN_PASSWORD=Admin@StockTrade2026
DEMO_BROKER_PASSWORD=Broker@StockTrade2026
DEMO_INVESTOR_PASSWORD=Investor@StockTrade2026
